<?xml version="1.0" encoding="UTF-8"?>
<!-- Every schema change, in order. Add a new file under changes/ and include it here; never edit an applied one. -->
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
			https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<include file="changes/001-create-events-table.xml" relativeToChangelogFile="true"/>
	<include file="changes/002-create-checkpoints-table.xml" relativeToChangelogFile="true"/>
	<include file="changes/003-create-event-annotations-table.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
